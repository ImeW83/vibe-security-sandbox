# Secrets
.env

# Agent-generated code stays out of the repo; only the folder itself is tracked
sandbox/*
!sandbox/.gitkeep

# OS and tooling noise
.DS_Store
Thumbs.db
__pycache__/
*.pyc
node_modules/
npm-debug.log*

# Run results stay out of the repo; only the folder itself is tracked
output/*
!output/.gitkeep

# Host-side venv for heal.py --llm (never inside the sandbox)
.venv-heal/
